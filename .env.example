# ── Tiawa React App — Environment Variables ──────────────────────────────────
# Copy this file to .env (local) and .env.production (build).
# Never commit .env or .env.production to version control.
#
# ┌──────────────────────────────────────────────────────┐
# │  .env            → local development (npm run dev)   │
# │  .env.production → production build  (npm run build) │
# └──────────────────────────────────────────────────────┘

# External API base URL.
# LOCAL : leave blank — Vite dev-server proxy forwards /requests & /reports
#         to https://api.tiawa.co (no CORS restriction in the browser).
# PROD  : set to https://api.tiawa.co
VITE_TIAWA_API_URL=

# API key (Bearer token). Request one at akwaaba@44technology.co
VITE_TIAWA_API_KEY=your_api_key_here

# Public app URL (used for canonical links / OG tags)
# LOCAL : http://localhost:5173
# PROD  : https://tiawa.co
VITE_APP_URL=http://localhost:5173

# App display name
VITE_APP_NAME=Tiawa
