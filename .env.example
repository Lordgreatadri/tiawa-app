# ── Tiawa React App — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# External API base URL.
# DEV  : leave blank — Vite proxy forwards /requests & /reports to https://api.44labs.co
# PROD : set to https://api.44labs.co
# VITE_ vars are bundled into the JS — do not store high-privilege secrets here.
VITE_TIAWA_API_URL=https://api.44labs.co
VITE_TIAWA_API_KEY=your_api_key_here

# Public app URL (used for canonical links / OG tags)
VITE_APP_URL=https://tiawa.co

# App display name
VITE_APP_NAME=Tiawa
